set dotenv-load

# list available recipes
[default]
list:
    @just --list --list-heading $'just what?\n' --list-prefix '~> '

# sync Python dependencies
sync:
    uv sync

# run the Flask server
run host='127.0.0.1' port='8765':
    uv run flask --app amp_host run --host "{{host}}" --port "{{port}}"

# run the Flask server on all interfaces for Tailscale access
tailscale port='8765':
    just run "0.0.0.0" "{{port}}"
